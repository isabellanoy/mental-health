PORT=3000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Opcional: añade ?pgbouncer=true&connection_limit=1 (el backend ya usa 1 conexión por instancia).
DATABASE_URL=
SUPABASE_URL=
# Clave secreta (service role): SOLO en el backend, nunca en el frontend ni en git
SUPABASE_SERVICE_KEY=

# Superadmin inicial: se crea en la tabla admins (con la contraseña hasheada) en su primer login.
# Después, la tabla manda: cambia la contraseña o crea más administradores desde el panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
